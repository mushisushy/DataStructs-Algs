#include <climits>
#include <iostream>
#include <vector>

class GuessAmount {
  std::vector<std::vector<int>> table;

  int maxSolution(int num, int initial, int length) {
    int cost =
        std::max(table[initial][num - 1], table[num + 1][initial + length - 1]);
    return num + cost;
  }

  int minCost(int start, int end) {
    int range = end - start + 1;
    table.resize(range + 1, std::vector<int>(range + 1, 0));

    for (size_t length = 2; length <= range; ++length) {
      for (size_t initialVal = 1; initialVal <= range - length + 1; ++initialVal) {
        int minimumCost = INT_MAX;
        for (size_t currentVal = initialVal; currentVal < initialVal + length - 1;
             ++currentVal) {
          int maxSolCost =
              currentVal +
              std::max(table[initialVal][currentVal - 1],
                       table[currentVal + 1][initialVal + length - 1]);
          minimumCost = std::min(maxSolCost, minimumCost);
        }
        table[initialVal][initialVal + length - 1] = minimumCost;
      }
    }
    return table[1][range];
  }

 public:
  int getMoneyAmount(int mini_amt) { return minCost(1, mini_amt); }
};

int main() {
  GuessAmount guessamount;

  int mini_amt;
  std::cin >> mini_amt;
  int result = guessamount.getMoneyAmount(mini_amt);
  std::cout << result;

  return 0;
}
