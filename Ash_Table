#include <iostream>
#include <vector>

class HashMap {
 private:
  static const int kTableSize = 1000003;
  std::vector<int> hash_table_;

  int HashFunction(int key) { return key % kTableSize; }

 public:
  HashMap() { hash_table_.resize(kTableSize, -1); }

  void Add(int key) {
    int index = HashFunction(key);
    while (hash_table_[index] != -1 && hash_table_[index] != key) {
      index = (index + 1) % kTableSize;
    }
    hash_table_[index] = key;
  }

  void Remove(int key) {
    int index = HashFunction(key);
    while (hash_table_[index] != -1 && hash_table_[index] != key) {
      index = (index + 1) % kTableSize;
    }
    if (hash_table_[index] == key) {
      hash_table_[index] = -1;
    }
  }

  bool Find(int key) {
    int index = HashFunction(key);
    while (hash_table_[index] != -1) {
      if (hash_table_[index] == key) {
        return true;
      }
      index = (index + 1) % kTableSize;
    }

    return false;
  }
};

void Menu(HashMap& myset) {
  char operation;
  int value;
  std::cin >> operation >> value;

  if (operation == '+') {
    myset.Add(value);
  } else if (operation == '-') {
    myset.Remove(value);
  } else if (operation == '?') {
    if (myset.Find(value)) {
      std::cout << "YES" << std::endl;
    } else {
      std::cout << "NO" << std::endl;
    }
  }
}

int main() {
  HashMap hashset;
  int n;
  std::cin >> n;
  for (int i = 0; i < n; i++) {
    Menu(hashset);
  };
}
