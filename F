#include <algorithm>
#include <iostream>
#include <stack>
#include <unordered_map>
#include <vector>

struct DirectedEdge {
  int src, dest;
};

class Graph {
  int vertices_;
  std::vector<std::vector<int>> adj_;
  std::vector<std::vector<int>> revAdj_;

 public:
  Graph(int n) : vertices_(n), adj_(n), revAdj_(n) {}

  void AddEdge(std::vector<DirectedEdge> const& edges) {
    for (long unsigned int i = 0; i < edges.size(); ++i) {
      int u = edges[i].src;
      int v = edges[i].dest;
      adj_[u].push_back(v);
      revAdj_[v].push_back(u);
    }
  }

  void DFS(int v, std::vector<bool>& visited, std::stack<int>& s) {
    visited[v] = true;
    for (long unsigned int i = 0; i < adj_[v].size(); ++i) {
      int neighbor = adj_[v][i];
      if (!visited[neighbor]) {
        DFS(neighbor, visited, s);
      }
    }
    s.push(v);
  }

  void RevDFS(int v, std::vector<bool>& visited, std::vector<int>& component) {
    visited[v] = true;
    component.push_back(v);
    for (long unsigned int i = 0; i < revAdj_[v].size(); ++i) {
      int neighbor = revAdj_[v][i];
      if (!visited[neighbor]) {
        RevDFS(neighbor, visited, component);
      }
    }
  }

  std::vector<std::vector<int>> Kosaraju() {
    std::stack<int> s;
    std::vector<bool> visited(vertices_, false);

    for (int i = 0; i < vertices_; ++i) {
      if (!visited[i]) {
        DFS(i, visited, s);
      }
    }

    for (long unsigned int i = 0; i < visited.size(); ++i) {
      visited[i] = false;
    }

    std::vector<std::vector<int>> strong_cc;

    while (!s.empty()) {
      int v = s.top();
      s.pop();

      if (!visited[v]) {
        std::vector<int> component;
        RevDFS(v, visited, component);
        strong_cc.push_back(component);
      }
    }

    return strong_cc;
  }

  Graph CondenseGraph(const std::vector<std::vector<int>>& components) {
    int new_vertices = components.size();
    Graph cond_graph(new_vertices);

    std::unordered_map<int, int> vertex_to_comp;

    for (size_t i = 0; i < components.size(); ++i) {
      for (size_t j = 0; j < components[i].size(); ++j) {
        int v = components[i][j];
        vertex_to_comp[v] = i;
      }
    }

    for (int i = 0; i < vertices_; ++i) {
      for (long unsigned int j = 0; j < adj_[i].size(); ++j) {
        int neighbor = adj_[i][j];
        int component_index = vertex_to_comp[i];
        int neighbor_comp_index = vertex_to_comp[neighbor];

        if (component_index != neighbor_comp_index) {
          cond_graph.AddEdge({{component_index, neighbor_comp_index}});
        }
      }
    }

    return cond_graph;
  }

  std::pair<int, int> CalculateDeg() {
    std::vector<int> in_degrees(vertices_, 0);
    std::vector<int> out_degrees(vertices_, 0);

    for (int i = 0; i < vertices_; ++i) {
      for (long unsigned int j = 0; j < adj_[i].size(); ++j) {
        int neighbor = adj_[i][j];
        out_degrees[i]++;
        in_degrees[neighbor]++;
      }
    }

    int zero_in_deg = count(in_degrees.begin(), in_degrees.end(), 0);
    int zero_out_deg = count(out_degrees.begin(), out_degrees.end(), 0);

    return {zero_in_deg, zero_out_deg};
  }
};

int main() {
  int n, m;
  std::cin >> n >> m;
  std::vector<DirectedEdge> edges_v;

  Graph graph(n);

  for (int i = 0; i < m; ++i) {
    int u, v;
    std::cin >> u >> v;
    DirectedEdge e = {u - 1, v - 1};
    edges_v.push_back(e);
  }
  graph.AddEdge(edges_v);

  std::vector<std::vector<int>> components = graph.Kosaraju();
  if (components.size() == 1) {
    std::cout << 0;
  } else {
    Graph condensed_graph = graph.CondenseGraph(components);

    std::pair<int, int> degrees = condensed_graph.CalculateDeg();

    std::cout << std::max(degrees.first, degrees.second);
  }
}
