#include <iostream>
#include <vector>

long long int Max(const std::vector<long long int>& arr) {
  const int kN = arr.size();
  long long int max_val = arr[0];
  for (int i = 1; i < kN; i++) {
    if (arr[i] > max_val) {
      max_val = arr[i];
    }
  }
  return max_val;
}

void CountingSort(std::vector<long long int>& arr, long long int exp) {
  const int kN = arr.size();
  const long long int kRadix = 256;
  std::vector<long long int> count(kRadix, 0);
  std::vector<long long int> output(kN);

  for (int i = 0; i < kN; ++i) {
    count[(arr[i] >> exp) & (kRadix - 1)]++;
  }

  for (int i = 1; i < kRadix; ++i) {
    count[i] += count[i - 1];
  }

  for (int i = kN - 1; i >= 0; --i) {
    output[count[(arr[i] >> exp) & (kRadix - 1)] - 1] = arr[i];
    count[(arr[i] >> exp) & (kRadix - 1)]--;
  }

  for (int i = 0; i < kN; ++i) {
    arr[i] = output[i];
  }
}

void RadixSort(std::vector<long long int>& arr) {
  long long int max_val = Max(arr);

  for (long long int exp = 0; max_val >> exp > 0; exp += 8) {
    CountingSort(arr, exp);
  }
}

int main() {
  int n;
  std::cin >> n;
  std::vector<long long int> arr(n);
  for (int i = 0; i < n; i++) {
    std::cin >> arr[i];
  }

  RadixSort(arr);

  for (int i = 0; i < n; i++) {
    std::cout << arr[i] << "\n";
  }
}
