#include <iostream>

bool BinarySearch(const int *begin, const int *end, int target) {
  const int *low = begin;
  const int *high = end - 1;
  while (low <= high) {
    const int *mid = low + (high - low) / 2;
    if (*mid < target) {
      low = mid + 1;
    } else if (*mid > target) {
      high = mid - 1;
    } else {
      return true;
    }
  }
  return false;

  delete low;
  delete high;
}

int main() {
  int num_elements, element, num_queries, start, stop, target;
  std::cin >> num_elements;
  int *ptr = new int[num_elements];
  for (int i = 0; i < num_elements; i++) {
    std::cin >> element;
    ptr[i] = element;
  }
  std::cin >> num_queries;
  for (int i = 0; i < num_queries; i++) {
    std::cin >> start >> stop >> target;

    int *begin = &ptr[start];
    int *end = &ptr[stop];

    BinarySearch(begin, end, target);
    if (BinarySearch(begin, end, target) == true) {
      std::cout << "YES\n";
    } else {
      std::cout << "NO\n";
    }
  }

  delete[] ptr;
}
