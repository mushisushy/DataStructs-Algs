#include <iostream>
#include <vector>
using namespace std;

struct HalfPlane {
  long long a;
  long long b;
  long long c;

  HalfPlane(pair<long long, long long> p1, pair<long long, long long> p2) {
    a = p2.second - p1.second;
    b = p2.first - p1.first;
    c = a * p1.first - b * p1.second;
  }

  bool isInside(pair<long long, long long> p, bool flip) {
    if (flip) return ((a * p.first - b * p.second - c) < 0);
    return ((a * p.first - b * p.second - c) > 0);
  }
};

int main() {
  int N;
  int M;
  long long x, y;
  double mx = 0, my = 0;
  bool flip = false;

  vector<pair<long long, long long>> polygon;
  vector<pair<long long, long long>> allies;
  vector<HalfPlane> HP;

  cin >> N;
  for (int i = 0; i < N; i++) {
    cin >> x;
    cin >> y;
    mx += x;
    my += y;
    polygon.push_back(make_pair(x, y));
  }

  mx = mx / N;
  my = my / N;

  cin >> M;
  for (int i = 0; i < M; i++) {
    cin >> x;
    cin >> y;
    allies.push_back(make_pair(x, y));
  }

  for (int i = 1; i < N; i++) {
    pair<long long, long long> p1 = polygon[i - 1];
    pair<long long, long long> p2 = polygon[i];
    HP.push_back(HalfPlane(p1, p2));
  }

  if ((HP[0].a * mx - HP[0].b * my - HP[0].c) <= 0) flip = true;

  for (long unsigned int i = 0; i < allies.size(); i++) {
    for (long unsigned int j = 0; j < HP.size(); j++) {
      if (!HP[j].isInside(allies[i], flip)) {
        cout << "NO";
        return 0;
      }
    }
  }

  cout << "YES";
  return 0;
}
