#include <iostream>
#include <string>

struct Node {
  std::string value;
  struct Node *next;
};

class List {
private:
  struct Node *head_ = nullptr;

public:

  ~List() {
    Node *current = head_;
    while (current != nullptr) {
      Node *next = current->next;
      delete current;
      current = next;
    }
  }

  void Insert(std::string sequence, int i = 0) {
  if (i >= sequence.length()) {
    return;
  }
  Node* temp_ = new Node{ std::string(1, sequence[i]), nullptr };
  if (head_ == nullptr) {
    head_ = temp_;
  } else {
    Node* traverse_ = head_;
    while (traverse_->next != nullptr) {
      traverse_ = traverse_->next;
    }
    traverse_->next = temp_;
  }
  Insert(sequence, ++i);
}


  void Reverse() {
    struct Node *prev_ = nullptr;
    struct Node *current_ = head_;
    struct Node *traverse_ = nullptr;
    while (current_ != nullptr) {
      traverse_ = current_->next;
      current_->next = prev_;
      prev_ = current_;
      current_ = traverse_;
    }
    head_ = prev_;
  }

  void Print() {
    struct Node *traverse_ = head_;
    while (traverse_ != nullptr) {

      std::cout << traverse_->value;
      traverse_ = traverse_->next;
    }
  }
};

int main(){
  std::string sequence;
  std::getline(std::cin, sequence);
  List mylist;
  mylist.Insert(sequence);
  mylist.Reverse();
  mylist.Print();
}
